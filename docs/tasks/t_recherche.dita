<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">

<task id="t_recherche" xml:lang="de-DE">
<!-- Hinweis: Bei Titeländerung Dateinamen und alle Referenzen auf diese Datei anpassen -->

  <title>Recherche</title>

  <taskbody>

    <context>
      <p>Für die Dokumentation der <term>Navigationsschnittstelle</term> recherchieren
      Sie alle relevanten technischen Unterlagen von
      <ph keyref="hersteller_opmi"/> und <ph keyref="hersteller_navi"/>.</p>
    </context>

    <steps>

      <step>
        <cmd>Fordern Sie die technischen Spezifikationen des
        <term>Operationsmikroskops</term> <ph keyref="produktname_opmi"/> bei
        <ph keyref="hersteller_opmi"/> an.</cmd>
      </step>

      <step>
        <cmd>Fordern Sie die technischen Spezifikationen des
        <term>Navigationsgeräts</term> <ph keyref="produktname_navi"/> bei
        <ph keyref="hersteller_navi"/> an.</cmd>
      </step>

      <step>
        <cmd>Prüfen Sie, ob bestehende Normen oder Standards für die Dokumentation
        von <term>Navigationsschnittstellen</term> relevant sind.</cmd>
      </step>

      <step>
        <cmd>Besuchen Sie die Website des Herstellers
        <ph keyref="hersteller_navi"/> für weiterführende
        technische Unterlagen.</cmd>
        <info>
          <xref keyref="link_hersteller_navi" format="html" scope="external">
          <!-- xref keyref: Referenziert einen externen Link über den Key aus
               external_links.ditamap – nie direkt per href auf die URL.
               format="html": Ziel ist eine Webseite.
               scope="external": Pflichtangabe für Links außerhalb des Projekts -->
            Website <ph keyref="hersteller_navi"/>
          </xref>
        </info>
      </step>

    </steps>

  </taskbody>
</task>