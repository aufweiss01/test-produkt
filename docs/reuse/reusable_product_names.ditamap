<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<map>
  <title>Produktnamen und Variablen (Keys)</title>
  <keydef keys="produktname">
    <topicmeta><linktext>Produktname XYZ</linktext></topicmeta>
  </keydef>
  <keydef keys="version">
    <topicmeta><linktext>1.0</linktext></topicmeta>
  </keydef>
  <keydef keys="firmenname">
    <topicmeta><linktext>Kundenname GmbH</linktext></topicmeta>
  </keydef>
</map>
