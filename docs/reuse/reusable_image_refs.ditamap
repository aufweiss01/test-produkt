<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA 1.3 Map//EN" "map.dtd">
<map xml:lang="de-DE">

  <title>Bildreferenzen</title>

  <keydef keys="img_navigationsschnittstelle"
          href="../images/opmi_navigationsschnittstelle.svg"
          format="svg">
