<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">

<concept id="c_arbeitsschritte" xml:lang="de-DE">
<!-- Hinweis: Bei Titeländerung Dateinamen und alle Referenzen auf diese Datei anpassen -->

  <title>Arbeitsschritte</title>
  <!-- Dieses Topic dient ausschließlich als Kapitelcontainer.
       Es enthält keinen eigenen Inhalt, sondern gruppiert die Task-Topics
       als Unterkapitel in der Haupt-Map. -->

  <prolog>
    <metadata>
      <audience type="user" job="operating" experiencelevel="general"/>
      <prodinfo>
        <prodname keyref="produktname"/>
        <vrmlist><vrm version="1.0"/></vrmlist>
      </prodinfo>
      <othermeta name="component" content="Navigationsschnittstelle"/>
      <othermeta name="lifecycle-stage" content="operation"/>
      <othermeta name="status" content="draft"/>
      <othermeta name="assignee" content=""/>
    </metadata>
    <!-- Erstelldatum, Änderungsdatum und Autor werden nicht im Prolog geführt.
        Diese Metadaten werden automatisch aus dem Git-Verlauf ausgelesen. -->
</prolog>

  <conbody/>
  <!-- conbody: Pflicht-Element; bleibt hier bewusst leer -->

</concept>